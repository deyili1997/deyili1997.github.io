---
layout: null
---
{% assign searchable = site.posts | concat: site.causal_inference %}
[
{% for note in searchable %}
  {
    "title": {{ note.title | jsonify }},
    "description": {{ note.description | default: '' | strip_html | jsonify }},
    "tags": {{ note.tags | jsonify }},
    "url": {{ note.url | relative_url | jsonify }},
    "date": {{ note.date | date: '%B %-d, %Y' | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
